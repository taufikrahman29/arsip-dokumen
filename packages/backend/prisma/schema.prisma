generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum Role {
  ADMIN
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Action {
  LOGIN
  LOGOUT
  UPLOAD
  UPDATE
  DELETE
  DOWNLOAD
}

// =============================================
// MODELS
// =============================================

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents    Document[]
  activityLogs ActivityLog[]
  sessions     Session[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  documents Document[]

  @@map("categories")
}

model Document {
  id             String     @id @default(uuid()) @db.Char(36)
  title          String     @db.VarChar(255)
  documentNumber String?    @map("document_number") @db.VarChar(100)
  description    String?    @db.Text
  categoryId     String?    @map("category_id") @db.Char(36)
  year           Int
  documentDate   DateTime?  @map("document_date") @db.Date
  fileName       String     @map("file_name") @db.VarChar(255)
  filePath       String     @map("file_path") @db.VarChar(500)
  fileUrl        String     @map("file_url") @db.Text
  fileType       String     @map("file_type") @db.VarChar(50)
  fileSize       BigInt     @map("file_size")
  visibility     Visibility @default(PUBLIC)
  uploadedBy     String?    @map("uploaded_by") @db.Char(36)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  uploader     User?         @relation(fields: [uploadedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)
  activityLogs ActivityLog[]

  @@index([visibility], map: "idx_documents_visibility")
  @@index([categoryId], map: "idx_documents_category")
  @@index([year], map: "idx_documents_year")
  @@index([uploadedBy], map: "idx_documents_uploaded_by")
  @@index([createdAt], map: "idx_documents_created_at")
  @@index([deletedAt], map: "idx_documents_deleted_at")
  @@map("documents")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  userName    String?  @map("user_name") @db.VarChar(255)
  action      Action
  documentId  String?  @map("document_id") @db.Char(36)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId], map: "idx_logs_user")
  @@index([action], map: "idx_logs_action")
  @@index([documentId], map: "idx_logs_document")
  @@index([createdAt], map: "idx_logs_created_at")
  @@map("activity_logs")
}

model AppSetting {
  id                String   @id @default(uuid()) @db.Char(36)
  siteTitle         String   @default("") @map("site_title") @db.VarChar(255)
  siteTagline       String   @default("") @map("site_tagline") @db.Text
  institutionName   String   @default("Kementerian Imigrasi dan Pemasyarakatan Republik Indonesia") @map("institution_name") @db.VarChar(255)
  siteLogo          String?  @map("site_logo") @db.Text
  heroEmblem        String?  @map("hero_emblem") @db.Text
  heroBg            String?  @map("hero_bg") @db.Text
  primaryColor      String   @default("#2563EB") @map("primary_color") @db.VarChar(20)
  heroOverlayOpacity Int     @default(75) @map("hero_overlay_opacity")
  heroOverlayColor  String   @default("#0F172A") @map("hero_overlay_color") @db.VarChar(20)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Session {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  refreshToken String   @map("refresh_token") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId], map: "idx_sessions_user")
  @@index([refreshToken], map: "idx_sessions_token")
  @@map("sessions")
}
